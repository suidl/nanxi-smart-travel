# ===== AI 模型配置（替换 gpt-5.4-mini）=====
# 统一使用 YONGJIA 作为 API Key 环境变量名，密钥请自行替换 kkkk
YONGJIA=kkkk
# 模型服务地址（独立变量，避免与 Netlify AI Gateway 注入的 OPENAI_BASE_URL 冲突）
YONGJIA_BASE_URL=https://api.deepseek.com

# --- 方案 A：DeepSeek（默认 deepseek-flash）---
# YONGJIA_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# --- 方案 B：阿里百炼（DashScope 兼容模式）---
# YONGJIA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# 说明：
# 1. 取消对应方案的注释即可启用，两个方案不要同时启用。
# 2. 阿里百炼可选模型：qwen-turbo / qwen-plus / qwen-max / qwen-long 等。
# 3. 默认模型为 deepseek-flash（当 AI_MODEL 未设置时生效）。
